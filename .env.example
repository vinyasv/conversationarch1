# Copy to .env and fill in. .env is gitignored.
OPENROUTER_API_KEY=
# Needed for claude-* models (e.g. --preset claude).
ANTHROPIC_API_KEY=

# Models (OpenRouter ids). Defaults shown.
CC_EXECUTOR_MODEL=openai/gpt-6-luna
# The extractor defaults to the executor model when unset.
# CC_EXTRACTOR_MODEL=openai/gpt-6-luna
CC_USER_MODEL=openai/gpt-4o-mini
CC_SYSTEM_MODEL=openai/gpt-4o-mini

# Floor applied to every max_tokens value (all arms equally). The harness caps
# non-reasoning models at 1000 tokens, which truncates thinking models like Gemini 3.8.
CC_MIN_MAX_TOKENS=8192

# Optional OpenRouter reasoning effort for models that support it (low | medium | high).
# Applies to every call, so all arms are affected identically.
# CC_REASONING_EFFORT=low

# Thinking for every Claude call (off | adaptive). --claude-thinking overrides it.
# CC_CLAUDE_THINKING=off
